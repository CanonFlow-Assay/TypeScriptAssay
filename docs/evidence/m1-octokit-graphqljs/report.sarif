          "rules": [
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "In configured boundary files, exported function parameters whose annotation names a configured trusted domain type are reported. This is a bounded ownership check, not a proof that every JSON value was decoded."
              },
              "id": "TSA-B01",
              "shortDescription": {
                "text": "Boundary parameters do not claim a trusted domain type"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Reports explicit any syntax and compiler-reported implicit-any diagnostics in the selected scope."
              },
              "id": "TSA-B02",
              "shortDescription": {
                "text": "any is forbidden"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Reports as, type assertions, non-null assertions, @ts-ignore, and @ts-expect-error; policy chooses forbid or allow-with-receipt for each class."
              },
              "id": "TSA-B03",
              "shortDescription": {
                "text": "Soundness escape hatches are explicit policy evidence"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Reports throw statements in configured domain files. It does not infer whether every function result is a result-like union."
              },
              "id": "TSA-D01",
              "shortDescription": {
                "text": "Domain failures do not throw"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "For switch expressions whose checked union members expose a configured string-literal discriminator, reports missing literal cases. A default clause alone is not accepted as proof of handling."
              },
              "id": "TSA-D02",
              "shortDescription": {
                "text": "Configured discriminated unions are exhaustive"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Reports non-literal element access in domain files unless it is lexically guarded by key in object or Object.hasOwn(object, key). It is not a proof of every runtime key invariant."
              },
              "id": "TSA-D03",
              "shortDescription": {
                "text": "Dynamic indexed access is refined before use"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Reports imports of known Node infrastructure modules and direct use of fetch, console, process, timers, Math.random, and Date.now in domain files."
              },
              "id": "TSA-E01",
              "shortDescription": {
                "text": "Domain modules do not directly use known infrastructure effects"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Reports a domain import that resolves to a configured boundary/adapters source file. It does not infer architectural intent beyond that dependency edge."
              },
              "id": "TSA-E02",
              "shortDescription": {
                "text": "Domain modules do not depend on configured adapters"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Reports Array, Map, Set and mutable object properties in exported domain type/interface declarations. readonly is static only; no deep runtime immutability is claimed."
              },
              "id": "TSA-I01",
              "shortDescription": {
                "text": "Public domain contracts do not expose mutable collection or object shapes"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Reports assignments through a property/index and recognized mutating collection methods in configured domain files."
              },
              "id": "TSA-I02",
              "shortDescription": {
                "text": "Domain mutation is forbidden"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Reports references in domain files to a policy-listed transport/DTO type name. It does not prove runtime schema completeness."
              },
              "id": "TSA-S01",
              "shortDescription": {
                "text": "Configured transport type names do not enter domain code"
              }
            }
          ],
          "version": "0.1.0"
        }
