{
  "schemaVersion": "ts-assay-policy/0.1",
  "profile": "new",
  "domainGlobs": ["src/domain/**/*.ts"],
  "boundaryGlobs": [],
  "excludedGlobs": [],
  "requiredCommands": ["node -e \"process.exit(0)\""],
  "escapeHatches": {
    "assertions": "forbid",
    "nonNullAssertions": "forbid",
    "directives": "forbid"
  },
  "discriminantFields": ["kind"],
  "transportTypeNames": ["UserDto"]
}
