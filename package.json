{
  "name": "typescript-assay",
  "version": "0.1.1",
  "description": "Deterministic functional-TypeScript engineering-policy verifier",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CanonFlow-Assay/TypeScriptAssay.git"
  },
  "homepage": "https://github.com/CanonFlow-Assay/TypeScriptAssay#readme",
  "bugs": {
    "url": "https://github.com/CanonFlow-Assay/TypeScriptAssay/issues"
  },
  "keywords": [
    "typescript",
    "static-analysis",
    "functional-programming",
    "engineering-policy",
    "sarif"
  ],
  "private": false,
  "type": "module",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "bin": {
    "ts-assay": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=20.20.2 <21"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests/*.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test dist/tests/assay.test.js",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.5",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "typescript-eslint": "8.18.0"
  },
  "dependencies": {
    "fast-glob": "3.3.2",
    "typescript": "5.7.3"
  }
}
